with(DifferentialThomas):
with(Tools):
Ranking([t], [[x1, x2], [y] ]);


sys := [
 diff(x2(t), t) - x2(t) * (convert(0.5,rational) - a * x1(t) + convert(0.2,rational) * x2(t)),
 diff(x1(t), t) - x1(t) * (convert(0.1,rational) + convert(0.9,rational) * x1(t) +  a * x2(t)),
 y(t) - (convert(0.9,rational) * x1(t)^2 + convert(0.2,rational) * x2(t)^2)
];

res := CodeTools[CPUTime](ThomasDecomposition(sys));